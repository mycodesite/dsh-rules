{
  "name": "rulebase",
  "version": "0.1.1",
  "engines": {
    "node": ">=22.5"
  },
  "description": "RuleBase：全局+项目两级 md 规则文件，注入 dsh 系统提示词，并在设置面板提供规则管理界面。",
  "license": "MIT",
  "author": "mycodesite",
  "homepage": "https://github.com/mycodesite/dsh-rules",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mycodesite/dsh-rules.git"
  },
  "bugs": {
    "url": "https://github.com/mycodesite/dsh-rules/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "rulebase",
    "rules",
    "markdown"
  ],
  "type": "module",
  "main": "lib/index.mjs",
  "types": "lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "connection"
      ],
      "immediately": false
    }
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "npm run build:host && npm run build:client",
    "build:host": "tsdown",
    "build:client": "node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "test": "node --test tests/smoke.test.ts",
    "pack:verify": "npm pack --dry-run",
    "sync-dsh": "node scripts/sync-dsh-deps.mjs",
    "update-dsh": "node scripts/sync-dsh-deps.mjs && npm install",
    "check-deps": "npm install --dry-run --strict-peer-deps"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1-rc.1 <5",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.1-rc.2 <1",
    "@deepseek-ai/dsh-agent": ">=0.1.1-rc.2 <1",
    "@deepseek-ai/dsh-llm": ">=0.1.1-rc.2 <1",
    "@deepseek-ai/dsh-client-connection": ">=0.1.1-rc.2 <1",
    "@deepseek-ai/dsh-host-apiproxy": ">=0.1.1-rc.2 <1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-apiproxy": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-attachment": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-brand": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-host-apiproxy": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-timeout": "^0.1.1-rc.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "esbuild": "^0.28.2",
    "react": "^19.2.8",
    "tsdown": "^0.22.14",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000"
}
